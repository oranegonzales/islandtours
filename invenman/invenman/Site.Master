<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="invenman.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style type="text/css">
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #0b1220;
            color: #e5e7eb;
        }

        .container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            max-width: none;
            padding: 0;
        }

        .header, .footer {
            background: #0f172a;
            padding: 16px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.10);
        }

        .footer {
            border-top: 1px solid rgba(255,255,255,0.10);
            border-bottom: none;
        }

        .main {
            display: flex;
            flex-grow: 1;
            gap: 14px;
            padding: 14px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
        }

        .column {
            padding: 14px;
            border: 1px solid rgba(255,255,255,0.10);
            background: rgba(17, 24, 39, 0.85);
            border-radius: 14px;
            box-sizing: border-box;
        }

        .menu, .adspane {
            flex-basis: 240px;
            flex-shrink: 0;
        }

        .contentpane {
            flex-grow: 1;
        }

        .header-image {
            max-width: 100%;
            height: auto;
            display: inline-block;
        }

        .header-title {
            margin: 10px 0 2px 0;
            font-size: 22px;
            font-weight: 800;
        }

        .header-subtitle {
            margin: 0;
            font-size: 13px;
            color: #cbd5e1;
        }

        .menu h5, .adspane h5 {
            margin: 0 0 10px 0;
            font-size: 15px;
            font-weight: 800;
        }

        .menu a {
            color: #e5e7eb;
            text-decoration: none;
        }

        .menu a:hover {
            text-decoration: underline;
        }

        .menu .section-title {
            margin-top: 12px;
            font-size: 12px;
            font-weight: 800;
            color: #93c5fd;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .menu ul {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

        .menu li {
            margin: 6px 0;
        }

        .menu .sub {
            margin-top: 6px;
            padding-left: 12px;
            border-left: 2px solid rgba(255,255,255,0.12);
        }

        .auth-box {
            padding: 10px;
            border: 1px solid rgba(255,255,255,0.10);
            border-radius: 12px;
            background: rgba(2, 6, 23, 0.45);
            margin-bottom: 12px;
        }

        .auth-line {
            font-size: 12.5px;
            color: #cbd5e1;
            margin-bottom: 10px;
            display: block;
        }

        .tt-btn {
            display: block;
            width: 100%;
            padding: 10px 12px;
            border-radius: 10px;
            border: none;
            text-align: center;
            font-weight: 800;
            background: #ffb703;
            color: #0b1220;
            text-decoration: none;
            transition: background 0.15s ease-in-out;
        }

        .tt-btn:hover {
            background: #fb8500;
            color: #0b1220;
            text-decoration: none;
        }

        .tt-btn:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(255,183,3,0.35);
        }

        .tt-btn.disabled,
        .tt-btn[disabled] {
            opacity: 0.55;
            pointer-events: none;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: 0;
            margin: 0;
        }

        .form-check-input {
            margin: 0;
            width: 18px;
            height: 18px;
            background-color: rgba(255,255,255,0.10);
            border: 1px solid rgba(255,255,255,0.35);
            box-shadow: none;
        }

        .form-check-input:checked {
            background-color: #ffb703;
            border-color: #ffb703;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(255,183,3,0.25);
        }

        .form-check-label {
            margin: 0;
            line-height: 1;
            color: #cbd5e1;
        }

        .adspane img {
            max-width: 100%;
            height: auto;
            display: block;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.12);
        }

        .adspane .ad-caption {
            margin-top: 10px;
            font-size: 12px;
            color: #cbd5e1;
        }

        .tt-panel {
            background: #020617;
            border-radius: 18px;
            padding: 24px;
            max-width: 960px;
            margin: 0 auto;
        }

        .tt-panel h2 {
            font-size: 28px;
            margin-bottom: 4px;
        }

        .tt-panel .tt-subline {
            font-size: 13px;
            color: #9ca3af;
            margin-bottom: 16px;
        }

        .tt-table {
            width: 100%;
            margin: 0 auto;
        }

        .tt-table th,
        .tt-table td {
            vertical-align: middle;
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <div class="container">

            <div class="header">
                <img id="imgHeader" runat="server" class="header-image" src="~/Images/header.png" alt="Header" />
                <div class="header-title">IslandExplore Jamaica Tours</div>
                <div class="header-subtitle">Client, attraction, booking, and payment management</div>
            </div>

            <div class="main">

                <div class="column menu">
                    <h5>Menu</h5>

                    <div class="auth-box">
                        <asp:Label ID="lblAuthStatus" runat="server" CssClass="auth-line"></asp:Label>

                        <asp:HyperLink ID="lnkHomeTop" runat="server" NavigateUrl="~/Home.aspx" CssClass="tt-btn mb-2">Home</asp:HyperLink>

                        <asp:Panel ID="pnlLoggedOut" runat="server">
                            <div class="d-grid gap-2">
                                <asp:HyperLink ID="lnkStaffLogin" runat="server" NavigateUrl="~/Login.aspx" CssClass="tt-btn">Staff Login</asp:HyperLink>
                                <asp:HyperLink ID="lnkClientLogin" runat="server" NavigateUrl="~/ClientLogin.aspx" CssClass="tt-btn">Client Login</asp:HyperLink>
                            </div>
                        </asp:Panel>

                        <asp:Panel ID="pnlLoggedIn" runat="server">
                            <div class="d-grid">
                                <asp:HyperLink ID="lnkLogout" runat="server" NavigateUrl="~/Logout.aspx" CssClass="tt-btn">Logout</asp:HyperLink>
                            </div>
                        </asp:Panel>
                    </div>

                    <asp:Panel ID="pnlStaffMenuItems" runat="server">
                        <div class="section-title">Client Management</div>
                        <ul class="sub">
                            <li><a runat="server" href="~/ClientAdd.aspx">Add client information</a></li>
                            <li><a runat="server" href="~/ClientList.aspx">View client list</a></li>
                            <li><a runat="server" href="~/ClientSearch.aspx">Search clients</a></li>
                            <li><a runat="server" href="~/ClientBookingHistory.aspx">View client booking history</a></li>
                        </ul>

                        <div class="section-title">Attractions Management</div>
                        <ul class="sub">
                            <li><a runat="server" href="~/AttractionAddEdit.aspx">Add/Edit attraction details</a></li>
                            <li><a runat="server" href="~/AttractionStatus.aspx">Deactivate / activate attractions</a></li>
                            <li><a runat="server" href="~/AttractionList.aspx">View all attractions</a></li>
                            <li><a runat="server" href="~/AttractionPricing.aspx">Set attraction base pricing</a></li>
                        </ul>

                        <div class="section-title">Booking Management</div>
                        <ul class="sub">
                            <li><a runat="server" href="~/BookingCreate.aspx">Create new booking</a></li>
                            <li><a runat="server" href="~/BookingModifyCancel.aspx">Modify or cancel booking</a></li>
                            <li><a runat="server" href="~/BookingUpcomingTours.aspx">View upcoming tours</a></li>
                            <li><a runat="server" href="~/BookingCalendar.aspx">View booking calendar</a></li>
                            <li><a runat="server" href="~/BookingAssignTransportation.aspx">Assign transportation</a></li>
                            <li><a runat="server" href="~/BookingInvoices.aspx">Generate invoices</a></li>
                        </ul>

                        <div class="section-title">Payments</div>
                        <ul class="sub">
                            <li><a runat="server" href="~/PaymentRecord.aspx">Make payment</a></li>
                            <li><a runat="server" href="~/PaymentHistory.aspx">View payment history</a></li>
                            <li><a runat="server" href="~/PaymentRefunds.aspx">Issue refunds</a></li>
                            <li><a runat="server" href="~/PaymentHistory.aspx">Generate receipt</a></li>
                        </ul>

                        <div class="section-title">Reports &amp; Analytics</div>
                        <ul class="sub">
                            <li><a runat="server" href="~/ReportsSales.aspx">Sales reports (daily / monthly / yearly)</a></li>
                            <li><a runat="server" href="~/ReportsBestSelling.aspx">Best selling tour packages</a></li>
                            <li><a runat="server" href="~/ReportsAttractionPopularity.aspx">Attraction popularity report</a></li>
                            <li><a runat="server" href="~/ReportsClientDemographics.aspx">Client demographics</a></li>
                            <li><a runat="server" href="~/ReportsPaymentPerformance.aspx">Payment performance reports</a></li>
                        </ul>

                        <asp:Panel ID="pnlAdminMenu" runat="server">
                            <div class="section-title">System Administration</div>
                            <ul class="sub">
                                <li><a runat="server" href="~/AdminUserRoles.aspx">User accounts / roles</a></li>
                                <li><a runat="server" href="~/AdminAuditLogs.aspx">Audit logs</a></li>
                                <li><a runat="server" href="~/AdminSystemConfig.aspx">System configuration</a></li>
                            </ul>
                        </asp:Panel>
                    </asp:Panel>

                    <asp:Panel ID="pnlClientMenuItems" runat="server">
                        <div class="section-title">Booking Management</div>
                        <ul class="sub">
                            <li><a runat="server" href="~/BookingCreate.aspx">Create new booking</a></li>
                            <li><a runat="server" href="~/BookingModifyCancel.aspx">Modify or cancel booking</a></li>
                            <li><a runat="server" href="~/BookingUpcomingTours.aspx">View upcoming tours</a></li>
                            <li><a runat="server" href="~/BookingCalendar.aspx">View booking calendar</a></li>
                            <li><a runat="server" href="~/BookingAssignTransportation.aspx">Assign transportation</a></li>
                            <li><a runat="server" href="~/BookingInvoices.aspx">Generate invoices</a></li>
                            <li><a runat="server" href="~/PublicAttractions.aspx">View public attractions</a></li>
                        </ul>

                        <div class="section-title">Payments</div>
                        <ul class="sub">
                            <li><a runat="server" href="~/PaymentRecord.aspx">Make payment</a></li>
                            <li><a runat="server" href="~/PaymentHistory.aspx">View payment history</a></li>
                        </ul>
                    </asp:Panel>
                </div>

                <div class="column contentpane">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>

                <div class="column adspane">
                    <h5>Adspane</h5>
                    <asp:AdRotator ID="AdRotator1" runat="server" AdvertisementFile="~/App_Data/Ads.xml" KeywordFilter="default" Target="_blank" />
                    <div class="ad-caption">Ads open in a new tab.</div>
                </div>

            </div>

            <div class="footer">
                <div>Copyright <%= DateTime.Now.Year %> Orane Gonzales</div>
            </div>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </form>
</body>
</html>