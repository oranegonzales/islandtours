<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="invenman.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#19324a" />
    <title><%: Page.Title %> · IslandExplore</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous" />
    <link href="~/Content/layout.css" rel="stylesheet" runat="server" />
    <link href="~/Content/Site.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-shell">
            <header class="topbar">
                <a runat="server" href="~/Home.aspx" class="brand" aria-label="IslandExplore home">
                    <span class="brand-mark" aria-hidden="true">IE</span>
                    <span>
                        <strong>IslandExplore</strong>
                        <small>Tour operations</small>
                    </span>
                </a>

                <div class="account">
                    <asp:Label ID="lblAuthStatus" runat="server" CssClass="account-name"></asp:Label>
                    <asp:Panel ID="pnlLoggedOut" runat="server" CssClass="account-links">
                        <asp:HyperLink ID="lnkStaffLogin" runat="server" NavigateUrl="~/Login.aspx">Staff sign in</asp:HyperLink>
                        <asp:HyperLink ID="lnkClientLogin" runat="server" NavigateUrl="~/ClientLogin.aspx">Client sign in</asp:HyperLink>
                    </asp:Panel>
                    <asp:Panel ID="pnlLoggedIn" runat="server" CssClass="account-links">
                        <asp:HyperLink ID="lnkLogout" runat="server" NavigateUrl="~/Logout.aspx">Sign out</asp:HyperLink>
                    </asp:Panel>
                </div>
            </header>

            <div class="workspace">
                <aside class="sidebar" aria-label="Primary navigation">
                    <asp:HyperLink ID="lnkHomeTop" runat="server" NavigateUrl="~/Home.aspx" CssClass="nav-home">Overview</asp:HyperLink>

                    <asp:Panel ID="pnlStaffMenuItems" runat="server">
                        <nav class="nav-sections">
                            <section>
                                <h2>Clients</h2>
                                <a runat="server" href="~/ClientAdd.aspx">Add client</a>
                                <a runat="server" href="~/ClientList.aspx">Client directory</a>
                                <a runat="server" href="~/ClientSearch.aspx">Search</a>
                                <a runat="server" href="~/ClientBookingHistory.aspx">Booking history</a>
                            </section>
                            <section>
                                <h2>Attractions</h2>
                                <a runat="server" href="~/AttractionAddEdit.aspx">Attraction details</a>
                                <a runat="server" href="~/AttractionStatus.aspx">Availability</a>
                                <a runat="server" href="~/AttractionList.aspx">Attraction directory</a>
                                <a runat="server" href="~/AttractionPricing.aspx">Pricing</a>
                            </section>
                            <section>
                                <h2>Bookings</h2>
                                <a runat="server" href="~/BookingCreate.aspx">Create booking</a>
                                <a runat="server" href="~/BookingModifyCancel.aspx">Changes and cancellations</a>
                                <a runat="server" href="~/BookingUpcomingTours.aspx">Upcoming tours</a>
                                <a runat="server" href="~/BookingCalendar.aspx">Calendar</a>
                                <a runat="server" href="~/BookingAssignTransportation.aspx">Transportation</a>
                                <a runat="server" href="~/BookingInvoices.aspx">Invoices</a>
                            </section>
                            <section>
                                <h2>Payments</h2>
                                <a runat="server" href="~/PaymentRecord.aspx">Record payment</a>
                                <a runat="server" href="~/PaymentHistory.aspx">Payment history</a>
                                <a runat="server" href="~/PaymentRefunds.aspx">Refunds</a>
                            </section>
                            <section>
                                <h2>Reports</h2>
                                <a runat="server" href="~/ReportsSales.aspx">Sales</a>
                                <a runat="server" href="~/ReportsBestSelling.aspx">Best sellers</a>
                                <a runat="server" href="~/ReportsAttractionPopularity.aspx">Attraction demand</a>
                                <a runat="server" href="~/ReportsClientDemographics.aspx">Client demographics</a>
                                <a runat="server" href="~/ReportsPaymentPerformance.aspx">Payment performance</a>
                            </section>
                            <asp:Panel ID="pnlAdminMenu" runat="server">
                                <section>
                                    <h2>Administration</h2>
                                    <a runat="server" href="~/AdminUserRoles.aspx">Users and roles</a>
                                    <a runat="server" href="~/AdminAuditLogs.aspx">Audit log</a>
                                    <a runat="server" href="~/AdminSystemConfig.aspx">Configuration</a>
                                </section>
                            </asp:Panel>
                        </nav>
                    </asp:Panel>

                    <asp:Panel ID="pnlClientMenuItems" runat="server">
                        <nav class="nav-sections">
                            <section>
                                <h2>Your trips</h2>
                                <a runat="server" href="~/BookingCreate.aspx">Create booking</a>
                                <a runat="server" href="~/BookingModifyCancel.aspx">Change booking</a>
                                <a runat="server" href="~/BookingUpcomingTours.aspx">Upcoming tours</a>
                                <a runat="server" href="~/BookingCalendar.aspx">Calendar</a>
                                <a runat="server" href="~/BookingAssignTransportation.aspx">Transportation</a>
                                <a runat="server" href="~/BookingInvoices.aspx">Invoices</a>
                                <a runat="server" href="~/PublicAttractions.aspx">Attractions</a>
                            </section>
                            <section>
                                <h2>Payments</h2>
                                <a runat="server" href="~/PaymentRecord.aspx">Make payment</a>
                                <a runat="server" href="~/PaymentHistory.aspx">Payment history</a>
                            </section>
                        </nav>
                    </asp:Panel>
                </aside>

                <main class="content-pane">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </main>
            </div>

            <footer class="footer">
                <span>IslandExplore tour operations</span>
                <span>&copy; <%= DateTime.Now.Year %> Orane Gonzales</span>
            </footer>
        </div>
    </form>
</body>
</html>
